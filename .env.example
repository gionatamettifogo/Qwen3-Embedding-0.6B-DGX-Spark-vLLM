LLM_API_KEY=replace-with-your-embedding-api-key

# Default to loopback. Set a private interface address for remote clients.
BIND_HOST=127.0.0.1
PORT=8891
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.09-py3
HF_CACHE_DIRECTORY=${HOME}/.cache/huggingface
VLLM_CACHE_DIRECTORY=${HOME}/.cache/vllm

# GB10 shares memory with the host. The fraction is used for startup admission;
# the explicit byte count controls the actual KV cache reservation.
GPU_MEMORY_UTILIZATION=0.05
KV_CACHE_MEMORY_BYTES=1342177280
CONTAINER_MEMORY_LIMIT=12g
MAX_MODEL_LEN=8192
MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=8
